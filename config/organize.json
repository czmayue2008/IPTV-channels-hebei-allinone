      "keywords": [
        "CCTV",
        "CETV",
        "CGTN"
      ]
    },
    {
      "name": "卫视频道",
      "keywords": [
        "卫视"
      ]
    },
    {
      "name": "河北本地",
      "keywords": [
        "河北",
        "石家庄",
        "沧州",
        "承德",
        "张家口",
        "秦皇岛",
        "唐山",
