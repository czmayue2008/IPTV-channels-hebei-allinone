{
  "_about": "整理层配置。source 只读取本项目 output/ 下的抓取产物；整理结果写入 output/playlists/，绝不会改写源数据。",
  "source": {
    "playlist": "output/hbtv.m3u",
    "epg": "output/epg.xml"
  },
  "output_dir": "output/playlists",
  "list_name": "河北电信 IPTV",
  "epg_url": "/playlists/epg.xml",
  "server_port": 5000,
  "logo": {
    "dir": "logo",
    "base_url": "/logo/",
    "_base_url_note": "根相对路径 /logo/ 由本项目 Web 服务在内网提供；返回播放列表时会自动补全为当前访问主机的绝对地址。",
    "aliases": {
      "CCTV4中文国际欧洲": "CCTV4",
      "CCTV4中文国际美洲": "CCTV4",
      "CGTN 法语": "CGTN法语",
      "CGTN法语": "CGTN法语",
      "凤凰卫视中文台": "凤凰中文",
      "凤凰卫视资讯台": "凤凰资讯",
      "凤凰卫视电影台": "凤凰中文",
      "中国交通频道": "中国交通",
      "kaku少儿": "卡酷动画",
      "书画": "书画频道",
      "卫生健康": "百姓健康",
      "CCTV5+": "CCTV5+",
      "CCTV-5+高清": "CCTV5+",
      "CCTV16 4K": "CCTV16",
      "CCTV4K": "CCTV4K"
    }
  },
  "normalize": {
    "fullwidth_to_halfwidth": true,
    "strip_hd_words": [
      "超高清",
      "高清",
      "标清"
    ],
    "strip_chars": [
      "-"
    ],
    "map_4k_to_sd_id": true
  },
  "groups": [
